generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  hashedPassword   String?
  role             String   @default("student")
  emailVerified       Boolean  @default(false)
  verificationCode    String?
  phone               String?
  discordUsername      String?
  age                 String?
  profession          String?
  profilePhoto        String?
  onboardingCompleted Boolean  @default(false)
  adminNotes          String?
  isBot               Boolean  @default(false)
  referralCode        String?  @unique
  resetToken          String?
  resetTokenExpiry    DateTime?
  discountCode        String?
  discountPercent     Int?
  discountExpiresAt   DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  progress         LessonProgress[]
  quizSubmissions  QuizSubmission[]
  streaks          Streak[]
  enrollments      Enrollment[]
  coachingSessions CoachingSession[]
  referralsMade    Referral[] @relation("referrerReferrals")
  referredBy       Referral[] @relation("referredReferrals")
  deals            PipelineDeal[]
  notes            Note[]
  projects         Project[]
  emailLogs        EmailLog[]
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String
  order       Int      @unique
  lessons     Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  content     String
  videoUrl    String?
  pdfUrl      String?
  exercise    String?
  duration    String   @default("15 min")
  order       Int
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quiz     Quiz?
  progress LessonProgress[]

  @@unique([moduleId, order])
}

model Quiz {
  id           String         @id @default(cuid())
  lessonId     String         @unique
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  passingScore Int            @default(80)
  questions    QuizQuestion[]
  submissions  QuizSubmission[]
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type          String
  question      String
  options       String
  correctAnswer String
  explanation   String?
  order         Int

  @@unique([quizId, order])
}

model QuizSubmission {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  score     Int
  answers   String
  passed    Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  quiz Quiz @relation(fields: [quizId], references: [id])

  @@index([userId, quizId])
  @@index([userId, createdAt])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  status      String    @default("locked")
  completedAt DateTime?
  xpEarned    Int       @default(0)

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId, status])
}

model Streak {
  id     String   @id @default(cuid())
  userId String
  date   DateTime
  user   User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  tier      String
  status    String   @default("active")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, tier])
  @@index([userId, status])
  @@index([tier])
}

model CoachingSession {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime
  slot            String
  status          String   @default("pending")
  stripeSessionId String?
  stripePaymentId String?
  amount          Int      @default(7000)
  topic           String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PipelineDeal {
  id        String   @id @default(cuid())
  userId    String
  name      String
  company   String?
  value     Int      @default(0)
  stage     String   @default("lead")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Referral {
  id           String    @id @default(cuid())
  referrerId   String
  referredId   String
  referredTier String?
  commission   Int       @default(0)
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  paidAt       DateTime?

  referrer User @relation("referrerReferrals", fields: [referrerId], references: [id])
  referred User @relation("referredReferrals", fields: [referredId], references: [id])

  @@index([referrerId, status])
  @@index([referredId])
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  folder    String   @default("General")
  color     String   @default("#ffffff")
  icon      String   @default("")
  pinned    Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  url         String?
  status      String   @default("submitted")
  feedback    String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model EmailLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "nurture" | "free_followup" | "drip" | "weekly_recap" | "manual"
  sequence  Int?     // Which email in sequence (1, 2, 3...)
  subject   String
  status    String   @default("sent") // "sent" | "failed"
  variant   String?  // A/B test variant: "a" | "b" (null for non-tested emails)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
}
